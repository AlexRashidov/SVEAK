// ==========================================
// ИКОНКИ
// ==========================================
// @description - Переиспользуемые SVG-иконки
// ==========================================

mixin icon-placeholder()
    svg(
        width="48"
        height="48"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
    )
        rect(x="2" y="2" width="20" height="20" rx="4")
        circle(cx="9" cy="9" r="2")
        path(d="M22 16L17 11L8 20")

// ==========================================
// ИКОНКИ ДЛЯ ХЕДЕРА
// ==========================================

mixin icon-triangle()
    svg(
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
    )
        polygon(points="12 2 2 22 22 22 12 2")

mixin icon-circle()
    svg(
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
    )
